{
  "name": "dsh-tg-bridge",
  "version": "1.37.1",
  "description": "Drive DeepSeek Harness from Telegram: one project, model and session per forum topic",
  "type": "module",
  "main": "plugin-bridge.mjs",
  "bin": {
    "dsh-tg": "cli.mjs"
  },
  "scripts": {
    "start": "node bridge.mjs",
    "setup": "node setup.mjs",
    "check": "node setup.mjs --check",
    "menu": "node bot-menu.mjs",
    "doctor": "node bridge-kick.mjs",
    "test": "node --test",
    "secrets": "node scan-secrets.mjs --all",
    "hooks": "node install-hooks.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksvega/dsh-tg-bridge.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "telegram",
    "bridge",
    "bot",
    "whisper",
    "voice"
  ],
  "license": "MIT",
  "dependencies": {},
  "files": [
    "bot-menu.mjs",
    "bridge-kick.mjs",
    "bridge.mjs",
    "cli.mjs",
    "goal.mjs",
    "install-hooks.mjs",
    "plugin-bridge.mjs",
    "say.mjs",
    "scan-secrets.mjs",
    "setup.mjs",
    "sync-runtime.mjs",
    "core/",
    "model/",
    "turn/",
    "chat/",
    "profile/",
    "work/",
    "control/",
    "i18n/",
    "plugin/",
    "skills/",
    "docs/",
    "README.md",
    "QUICKSTART.md",
    "SECURITY.md",
    "cordis.patch.yml",
    "config.example.json",
    "install.ps1",
    "install.sh",
    "transcribe.py"
  ],
  "homepage": "https://github.com/aleksvega/dsh-tg-bridge#readme",
  "bugs": {
    "url": "https://github.com/aleksvega/dsh-tg-bridge/issues"
  }
}
