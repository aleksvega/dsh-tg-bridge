#!/bin/sh
# Generated by install-hooks.mjs — the secret scan must run, not be remembered.
here=$(git rev-parse --show-toplevel) || exit 0
node "$here/scan-secrets.mjs" || exit 1
# Then Jev's read of the diff: the scan proves what a string match can prove, and
# this asks whether the change is wrong. It skips itself when there is no key, no
# tool, or no time, and refuses only a syntax error, severity 4-5, or a security
# flag — see jev-gate.mjs for why the rest is advice.
node "$here/jev-gate.mjs" || exit 1
